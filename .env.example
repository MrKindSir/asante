# Asante application fallback configuration
# Copy this file to .env for local development and provide real service keys.

ASANTE_POSTGRES_DB=asante
ASANTE_POSTGRES_USER=asante
ASANTE_POSTGRES_PASSWORD=asante_local_dev_only
ASANTE_POSTGRES_PORT=5432

ASANTE_MINIO_ROOT_USER=asante
ASANTE_MINIO_ROOT_PASSWORD=asante_minio_local_dev_only
ASANTE_MINIO_BUCKETS=asante-media
ASANTE_MINIO_API_PORT=9000
ASANTE_MINIO_CONSOLE_PORT=9001

# Required when the Asante AI workers are enabled.
# Prefer ASANTE_AI_* (Gemini or OpenAI-compatible). OPENAI_API_KEY remains a fallback.
ASANTE_AI_PROVIDER=gemini
ASANTE_AI_API_KEY=
ASANTE_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
ASANTE_AI_MODEL=gemini-2.5-flash
# Optional Ollama upstream called server-side by API/job-worker containers.
# If configured it takes precedence over the cloud provider for LLM tasks.
# Localhost: leave ASANTE_AI_BACKEND empty and point ASANTE_OLLAMA_BASE_URL at host Ollama.
ASANTE_OLLAMA_BASE_URL=
ASANTE_OLLAMA_MODEL=llama3.2:latest
ASANTE_OLLAMA_VISION_MODEL=
ASANTE_WHISPER_MODEL=/workspace/models/whisper-tiny
OPENAI_API_KEY=
# Live only: set ASANTE_AI_BACKEND=modal and point at the deployed Modal Asante Ollama app.
# Do not enable this on localhost. Secrets stay in env / Modal secrets — never commit them.
ASANTE_AI_BACKEND=
ASANTE_MODAL_BASE_URL=
ASANTE_MODAL_SHARED_SECRET=
ASANTE_MODAL_WHISPER_MODEL=tiny
ASANTE_MODAL_TRANSCRIBE_TIMEOUT=240
# Live cost caps (Modal). Raise these later without code changes once the path is proven.
# Localhost ignores ASANTE_LIVE_* and uses ASANTE_CAPTION_SECONDS (default 180) instead.
ASANTE_LIVE_CAPTION_SECONDS=45
ASANTE_LIVE_TRANSLATE_MAX_CUES=12
ASANTE_LIVE_TRANSLATE_BATCH_SIZE=3
ASANTE_LIVE_TRANSLATE_DEADLINE_SECONDS=45
ASANTE_CAPTION_SECONDS=180
ASANTE_TRANSLATE_MAX_CUES=100

# Add the selected map provider key when the Asante map requires one.
ASANTE_MAP_TILE_TOKEN=
ASANTE_HTTP_PORT=80

# Local review dashboard only. Override for any shared environment.
ASANTE_REVIEWER_KEY=asante-local-review-only
