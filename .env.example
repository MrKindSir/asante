# DEPRECATED: do not copy secrets into a repo .env for Compose.
#
# Required Asante ports/credentials must live in the host shell profile:
#   localhost → ~/.zshrc
#   live      → /root/.bashrc (or /root/.profile)
#
# Then start with:
#   source ~/.zshrc
#   ./scripts/asante/compose.sh up -d --build
#
# Required exports (examples — use your own values, never commit them):
#   export ASANTE_BIND_HOST=127.0.0.1
#   export ASANTE_BIND_HTTP_HOST=127.0.0.1   # live edge may use 0.0.0.0 or 127.0.0.1 behind reverse proxy
#   export ASANTE_HTTP_PORT=8082
#   export ASANTE_POSTGRES_DB=asante
#   export ASANTE_POSTGRES_USER=asante
#   export ASANTE_POSTGRES_PASSWORD=...
#   export ASANTE_POSTGRES_PORT=5432
#   export ASANTE_MINIO_ROOT_USER=asante
#   export ASANTE_MINIO_ROOT_PASSWORD=...
#   export ASANTE_MINIO_BUCKETS=asante-media
#   export ASANTE_MINIO_API_PORT=9000
#   export ASANTE_MINIO_CONSOLE_PORT=9001
#
# Live AI (Modal HTTP app — not the Modal account token):
#   export ASANTE_AI_BACKEND=modal
#   export ASANTE_MODAL_BASE_URL=https://....modal.run
#   export ASANTE_MODAL_SHARED_SECRET=...
#
# Modal account CLI token stays in the shell profile / ~/.modal.toml only:
#   export MODAL_TOKEN_ID=...
#   export MODAL_TOKEN_SECRET=...
